rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImageUpload() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /products/{sellerId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == sellerId && isImageUpload();
      allow delete: if signedIn() && request.auth.uid == sellerId;
    }

    match /seller_profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId && isImageUpload();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /plant_identifications/{userId}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId && isImageUpload();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /disease_identifications/{userId}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId && isImageUpload();
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
